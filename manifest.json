{
  "manifest_version": 3,
  "name": "3MR — уведомления о почте для Mail.ru",
  "short_name": "3MR Почта",
  "version": "1.5.1",
  "description": "Счётчик непрочитанных писем Mail.ru на значке, список писем по клику и уведомления о новых. Пароль не нужен.",
  "minimum_chrome_version": "110",
  "icons": {
    "16": "img/icon16.png",
    "32": "img/icon32.png",
    "48": "img/icon48.png",
    "128": "img/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "3MR — непрочитанные письма Mail.ru",
    "default_icon": {
      "16": "img/icon16.png",
      "32": "img/icon32.png",
      "48": "img/icon48.png",
      "128": "img/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "alarms",
    "notifications",
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "https://portal.mail.ru/*",
    "https://auth.mail.ru/*",
    "https://e.mail.ru/*",
    "https://mailru-checker-api.e.mail.ru/*"
  ]
}
